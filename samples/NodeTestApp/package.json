{
  "name": "node-test-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "node build.cjs nugetRestore && node build.cjs runCppWinrt && node-gyp configure && npm run generate:winrt",
    "generate:winrt": "..\\..\\rnwinrt\\x64\\Debug\\rnwinrt.exe -node -input \"C:\\Program Files (x86)\\Windows Kits\\10\\References\\10.0.19041.0\\Windows.Foundation.FoundationContract\\4.0.0.0\\Windows.Foundation.FoundationContract.winmd\" D:\\react-native-winrt\\tests\\RnWinRTTests\\windows\\TestComponent\\x64\\Debug\\TestComponent\\TestComponent.winmd -include TestComponent -include Windows.Foundation -output ./generated",
    "copy:testdll": "powershell -Command \"Copy-Item 'D:\\react-native-winrt\\tests\\RnWinRTTests\\windows\\TestComponent\\x64\\Debug\\TestComponent\\TestComponent.dll' -Destination '.' -Force\"",
    "build": "node-gyp build --debug",
    "rebuild": "node-gyp configure --debug && node-gyp rebuild --debug",
    "start": "node index.js",
    "test": "npm run copy:testdll && copy \"C:\\Program Files\\nodejs\\node.exe\" . && .\\node es6test.js",
    "test:basic": ".\\node es6test.js"
  },
  "gypfile": true,
  "devDependencies": {
    "node-gyp": "^10.0.0",
    "bindings": "^1.5.0",
    "node-addon-api": "^7.0.0"
  }
}
