  "version": "0.1.0",
  "private": true,
  "scripts": {
    "preinstall": "node build.js nugetRestore && node build.js runCppWinrt && node-gyp configure",
    "build:addon": "node-gyp rebuild",
    "generate:winrt": "..\\..\\rnwinrt\\x64\\Debug\\rnwinrt.exe -node -input ..\\..\\tests\\RnWinRTTests\\windows\\TestComponent\\x64\\Debug\\TestComponent\\TestComponent.winmd -input \"C:\\Program Files (x86)\\Windows Kits\\10\\References\\10.0.19041.0\\Windows.Foundation.FoundationContract\\4.0.0.0\\Windows.Foundation.FoundationContract.winmd\" -include TestComponent -include Windows.Foundation -output ./generated",
    "build": "npm run generate:winrt && npm run build:addon",
